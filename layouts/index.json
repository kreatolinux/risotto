[
  {{- /* Search lists each package once, from the default stable branch. */ -}}
  {{- $pages := slice -}}
  {{- range site.Pages -}}{{- if not (hasPrefix .RelPermalink "/packages/master/") -}}{{- $pages = $pages | append . -}}{{- end -}}{{- end -}}
  {{- range $index, $page := $pages -}}
    {{- if $index -}},{{- end -}}
    {{- $content := $page.Plain -}}
    {{- if .Site.Params.search.truncateContent -}}
      {{- $content = substr $content 0 (int .Site.Params.search.truncateContent) -}}
    {{- end -}}
    {
      "title": {{ $page.Title | jsonify }},
      "permalink": {{ $page.Permalink | jsonify }},
      "content": {{ $content | jsonify }},
      "summary": {{ $page.Summary | plainify | jsonify }}
    }
  {{- end -}}
]
